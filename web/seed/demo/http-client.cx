// An HTTP client in CX: it fetches / from 127.0.0.1:8080 and prints the
// response. Start http-server.cx first:
//
//	cx --enable=net http-server.cx &
//	cx --enable=net http-client.cx
package main

import "sys/net"
import "sys/string"

var buffer [4096]ui8

func main() { global buffer
	var client i32 = net.TCPDial("127.0.0.1", 8080)
	var request []ui8 = string.BytesOfString("GET / HTTP/1.0\r\nHost: 127.0.0.1\r\n\r\n")
	var response []ui8
	var done bool
	var count i32
	var handle i32
	var trigger i32
	var message i32
	var detail i32
	var length i32
	var queued i32
	var i i32
	var j i32
	var updates i32
	for done == false && updates < 100 {
		count = net.Update(100)
		updates++
		for i = 0; i < count; i++ {
			handle, trigger, message, detail = net.ReadyNext()
			if trigger == net.TriggerConnected {
				for j = 0; j < len(request); j++ {
					buffer[j] = request[j]
				}
				queued = net.Write(client, buffer, len(request))
			}
			if trigger == net.TriggerData {
				length = net.Read(handle, message, buffer, 0)
				for j = 0; j < length; j++ {
					response = append(response, buffer[j])
				}
			}
			if trigger == net.TriggerClosed {
				done = true
			}
			if trigger == net.TriggerError {
				printf("error %d, is http-server.cx running?\n", detail)
				done = true
			}
		}
	}
	printf("%s", string.StringOfBytes(response))
	test(net.Close(client), true, "close the client")
}
