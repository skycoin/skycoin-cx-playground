// An HTTP server on 127.0.0.1:8080, written in CX on the net library.
// Start it in the background, then open it in the browser window:
//
//	cx --enable=net http-server.cx &
//	browse 127.0.0.1:8080
//
// In this tab 127.0.0.1 is bottle's vnet, shared by every process and the
// browser window. Natively it is the machine's loopback.
package main

import "sys/net"
import "sys/string"

var request [4096]ui8
var reply [4096]ui8

// replyFill copies text into reply and returns its length in bytes.
func replyFill(text str) (length i32) { global reply
	var bytes []ui8 = string.BytesOfString(text)
	length = len(bytes)
	var i i32
	for i = 0; i < length; i++ {
		reply[i] = bytes[i]
	}
}

func main() { global request, reply
	var listener i32 = net.TCPListen("127.0.0.1", 8080)
	var served i32
	var count i32
	var handle i32
	var trigger i32
	var message i32
	var detail i32
	var length i32
	var queued i32
	var closed bool
	var body str
	var i i32
	for true {
		count = net.Update(1000)
		for i = 0; i < count; i++ {
			handle, trigger, message, detail = net.ReadyNext()
			if trigger == net.TriggerListening {
				printf("listening on http://127.0.0.1:%d/\n", detail)
			}
			if trigger == net.TriggerError {
				printf("error %d on socket %d\n", detail, handle)
				if handle == listener {
					return
				}
			}
			if trigger == net.TriggerData {
				length = net.Read(handle, message, request, 0)
				served++
				body = sprintf("<html><body><h1>Hello from CX</h1><p>Request %d, answered by a CX program.</p></body></html>\n", served)
				length = replyFill(sprintf("HTTP/1.0 200 OK\r\nContent-Type: text/html\r\nContent-Length: %d\r\nConnection: close\r\n\r\n%s", string.ByteLength(body), body))
				queued = net.Write(handle, reply, length)
				closed = net.Close(handle)
				printf("served request %d\n", served)
			}
		}
	}
}
